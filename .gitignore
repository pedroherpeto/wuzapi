# runtime data: ignora o conteúdo mas MANTÉM a pasta no git via .gitkeep
# (o Dockerfile faz COPY de dbdata/ e files/ — sem a pasta, o build falha num clone fresco)
dbdata/*
!dbdata/.gitkeep
files/*
!files/.gitkeep
wuzapi
frontend/node_modules
frontend/package-lock.json
.env
.env.example
.tool-versions
meow_gui/
